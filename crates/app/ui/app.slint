import { Button, ComboBox, LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColumnLayout, ProcRow, Resource, ResourceKind, ResourceTint } from "types.slint";
import { ProcessPage, Columns, ProcessMenu } from "process-page.slint";
import { PerformancePage } from "performance-page.slint";
import { MiniWindow, OpacityChoice } from "mini-window.slint";
import { MemoryView } from "memory-detail.slint";
import { StatItem } from "stats-panel.slint";

export { ColumnLayout, MemoryView, ProcRow, Resource, ResourceKind, ResourceTint, StatItem, Columns, ProcessMenu, MiniWindow, OpacityChoice }
export { CoreGraph, CpuData, GridLayout } from "cpu-detail.slint";

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 34px;
    border-radius: 6px;
    background: touch.has-hover && !root.active ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Palette.foreground : Theme.subtle-text;
        }
    }

    Rectangle {
        y: parent.height - 3px;
        x: (parent.width - self.width) / 2;
        width: root.active ? 18px : 0px;
        height: 3px;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate width { duration: 150ms; easing: ease-out; }
    }
}

// 分段选择：一组互斥的选项并排显示，当前项高亮。
component SegmentedControl inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected(int);

    height: 30px;
    width: row.preferred-width;
    border-radius: 7px;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.divider;

    row := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for label[i] in root.model: Rectangle {
            width: caption.preferred-width + 24px;
            border-radius: 5px;
            background: i == root.current-index ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
            touch := TouchArea {
                clicked => {
                    root.current-index = i;
                    root.selected(i);
                }
            }

            caption := Text {
                text: label;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-weight: i == root.current-index ? 600 : 400;
                color: i == root.current-index ? Palette.foreground : Theme.subtle-text;
            }
        }
    }
}

// 盾牌图标：表示需要管理员权限的操作（与 Windows 的 UAC 盾牌同义），左半实心、右半描边。
component ShieldIcon inherits Rectangle {
    in property <brush> tint;
    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 8 1.6 L 8 14.6 C 4.9 13.7 2.6 11 2.6 7.6 L 2.6 3.6 Z";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 8 1.6 L 13.4 3.6 L 13.4 7.6 C 13.4 11 11.1 13.7 8 14.6 C 4.9 13.7 2.6 11 2.6 7.6 L 2.6 3.6 Z";
    }
}

// 图钉图标：窗口置顶。未置顶时描边，置顶时实心。
component PinIcon inherits Rectangle {
    in property <brush> tint;
    in property <bool> filled;
    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.filled ? root.tint : transparent;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 4.6 1.8 L 11.4 1.8 L 11.4 3.2 L 10.4 4 L 10.4 7.2 L 13 9.8 L 3 9.8 L 5.6 7.2 L 5.6 4 L 4.6 3.2 Z";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 8 9.8 L 8 14.8";
    }
}

// 迷你模式图标：大窗口的轮廓里，右上角一个实心小窗口。
component MiniIcon inherits Rectangle {
    in property <brush> tint;
    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 6.5 2.5 L 2.5 2.5 L 2.5 13.5 L 13.5 13.5 L 13.5 9.5";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 9 2 L 14 2 L 14 7 L 9 7 Z";
    }
}

// 图标按钮的悬停提示内容。
component TipBox inherits Rectangle {
    in property <string> text;
    background: Theme.surface-raised;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.dark ? #ffffff24 : #0000001f;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 5px;
        Text {
            text: root.text;
            font-size: 12px;
            color: Palette.foreground;
        }
    }
}

// 需要用户确认的操作：1 = 结束关键进程，2 = 结束进程树。
component ConfirmDialog inherits Rectangle {
    in property <int> kind;
    in property <string> name;
    in property <int> descendants;
    in property <bool> includes-critical;
    callback accepted();
    callback cancelled();

    background: #00000066;
    TouchArea { }

    card := Rectangle {
        width: min(420px, parent.width - 48px);
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 10px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.divider;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;

        body := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text {
                text: root.kind == 2 ? @tr("结束进程树？") : @tr("结束关键进程？");
                font-size: 18px;
                font-weight: 600;
                color: Palette.foreground;
            }

            Text {
                text: root.kind == 2
                    ? @tr("将结束 {0} 及其 {1} 个后代进程，未保存的数据会丢失。", root.name, root.descendants)
                    : @tr("{0} 是关键进程，结束它可能导致系统崩溃或注销。", root.name);
                wrap: word-wrap;
                color: Palette.foreground;
            }

            if root.kind == 2 && root.includes-critical: Text {
                text: @tr("其中包含关键进程，结束后系统可能崩溃或注销。");
                wrap: word-wrap;
                color: Theme.danger;
            }

            HorizontalLayout {
                padding-top: 8px;
                alignment: end;
                spacing: 8px;
                Button {
                    text: @tr("取消");
                    clicked => {
                        root.cancelled();
                    }
                }

                Button {
                    text: @tr("结束");
                    primary: true;
                    clicked => {
                        root.accepted();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("任务管理器 Lite");
    // 初始大小由 Rust 在显示前按设置写入。
    in property <length> initial-width: 1040px;
    in property <length> initial-height: 700px;
    preferred-width: root.initial-width;
    preferred-height: root.initial-height;
    min-width: 760px;
    min-height: 480px;
    always-on-top: root.pinned;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    background: Theme.surface;

    in property <[ProcRow]> rows;
    in-out property <int> selected: -1;
    in property <int> sort-key: 2;
    in property <bool> sort-descending: true;
    // 视图模式：0 平铺，1 树形，2 分组。
    in-out property <int> view-mode: 0;
    in-out property <string> filter;
    in-out property <int> page: 0;
    in-out property <int> interval-index: 1;
    in property <bool> elevated;
    // 窗口置顶，由 Rust 按设置恢复，退出时保存。
    in-out property <bool> pinned;
    in property <[Resource]> resources;
    in property <MemoryView> memory-view;
    in property <int> process-count;
    in property <string> cpu-summary;
    in property <string> memory-summary;

    // 状态栏消息：1 已结束，2 权限不足，3 进程已退出，4 取消提权，5 其他错误。
    in property <int> status-kind;
    in property <string> status-arg;

    in-out property <int> confirm-kind;
    in property <string> confirm-name;
    in property <int> confirm-descendants;
    in property <bool> confirm-critical;

    callback select(int);
    callback sort-by(int);
    callback toggle(int);
    callback filter-edited(string);
    callback view-changed(int);
    callback interval-changed(int);
    callback end-process();
    callback end-tree();
    callback confirm-accepted();
    callback elevate();
    callback graph-resized();
    // 切换到迷你模式（性能页工具栏按钮、双击性能页左栏卡片、Ctrl+M）。
    callback mini-mode();
    // 性能页选中的资源：实例 id 与它在 resources 中的下标，均由 Rust 维护。
    in property <string> selected-resource: "cpu";
    in property <int> resource-index: 0;
    callback resource-selected(string);
    out property <length> graph-width: perf-page.graph-width;
    out property <length> graph-height: perf-page.graph-height;

    // 工具栏随窗口变窄依次收缩：
    // 1. 搜索框从 220px 缩到“舒适宽度”，即恰好放下完整的占位文字（由布局完成）；
    // 2. 仍放不下时，“以管理员身份重启”收成盾牌图标按钮（悬停显示提示）；
    // 3. 还放不下时隐藏品牌字样（窗口标题栏仍显示应用名）。
    // 档位按搜索框的舒适宽度判断；最窄时（约 800 以下）搜索框再缩到只放下简短占位文字。判断只用不随档位变化的量（各部分的首选/最小宽度），避免绑定循环。
    private property <string> search-hint: @tr("搜索名称或 PID（Ctrl+F）");
    private property <string> search-hint-short: @tr("搜索名称或 PID");
    private property <string> elevate-text: @tr("以管理员身份重启");
    private property <string> mini-text: @tr("迷你模式（Ctrl+M）");
    private property <string> pin-text: root.pinned ? @tr("取消置顶") : @tr("窗口置顶");
    // Fluent 输入框左右内边距各 12px，另留 4px 光标余量。
    private property <length> search-comfort: min(220px, search-measure.preferred-width + 28px);
    private property <length> search-floor: min(root.search-comfort, max(140px, search-short-measure.preferred-width + 28px));
    // 左右内边距 16 + 12，左侧组、伸缩空白、右侧组之间两个 8px 间距。
    private property <length> toolbar-room: root.width - 44px;
    // Fluent 按钮左右内边距各 12px；提权按钮的需求含它与左侧控件的 8px 间距。
    private property <length> elevate-text-need: root.elevated ? 0px : max(32px, elevate-measure.preferred-width + 24px) + 8px;
    private property <length> elevate-icon-need: root.elevated ? 0px : 32px + 8px;
    private property <length> toolbar-core-need: tabs.preferred-width + toolbar-core.min-width + (root.page == 0 ? root.search-comfort - root.search-floor : 0px);
    out property <bool> toolbar-elevate-compact: brand.preferred-width + root.toolbar-core-need + root.elevate-text-need > root.toolbar-room;
    out property <bool> toolbar-brand-shown: brand.preferred-width + root.toolbar-core-need + (root.toolbar-elevate-compact ? root.elevate-icon-need : root.elevate-text-need) <= root.toolbar-room;
    // 截图模式与单元测试据此断言工具栏没有被挤出窗口（最小宽度不超过窗口宽度即没有控件被裁剪）。
    out property <length> toolbar-min-width: toolbar.min-width;

    // 供截图模式切换深浅色。
    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    function move-selection(delta: int) {
        if root.rows.length == 0 {
            return;
        }
        // 分组标题行不可选：落在标题行上就沿移动方向再走一格（标题行之间总隔着进程行，不会连续出现）。
        let base = max(0, min(root.rows.length - 1, root.selected + delta));
        root.selected = !root.rows[base].header ? base
            : delta < 0 ? (base > 0 ? base - 1 : base + 1)
            : (base + 1 < root.rows.length ? base + 1 : base - 1);
        root.select(root.selected);
        process-page.ensure-visible(root.selected);
    }

    keys := FocusScope {
        key-pressed(event) => {
            if root.confirm-kind != 0 {
                if event.text == Key.Escape {
                    root.confirm-kind = 0;
                    return accept;
                }
                return reject;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                root.page = 0;
                search.focus();
                return accept;
            }
            if event.modifiers.control && (event.text == "m" || event.text == "M") {
                root.mini-mode();
                return accept;
            }
            if root.page != 0 {
                return reject;
            }
            if event.text == Key.Delete {
                root.end-process();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.move-selection(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-selection(-1);
                return accept;
            }
            if event.text == Key.PageDown {
                root.move-selection(15);
                return accept;
            }
            if event.text == Key.PageUp {
                root.move-selection(-15);
                return accept;
            }
            reject
        }

        VerticalLayout {
            Rectangle {
                height: 56px;
                // 只用于测量宽度的隐藏文字，字体字号与搜索框占位文字、按钮文字相同。
                // 子元素都显式定位：这样它们的尺寸约束不会传给窗口，否则“档位 → 工具栏最小宽度 →
                // 窗口布局约束 → 窗口宽度 → 档位”会形成绑定循环。
                search-measure := Text {
                    x: 0px;
                    y: 0px;
                    visible: false;
                    text: root.search-hint;
                }

                search-short-measure := Text {
                    x: 0px;
                    y: 0px;
                    visible: false;
                    text: root.search-hint-short;
                }

                elevate-measure := Text {
                    x: 0px;
                    y: 0px;
                    visible: false;
                    text: root.elevate-text;
                }

                toolbar := HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;

                    // 左侧：品牌字样与页面 Tab。品牌始终参与测量，隐藏时占位宽度为 0。
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        Rectangle {
                            width: root.toolbar-brand-shown ? brand.preferred-width : 0px;
                            visible: root.toolbar-brand-shown;
                            brand := HorizontalLayout {
                                x: 0px;
                                width: self.preferred-width;
                                height: parent.height;
                                spacing: 8px;
                                // 与 Tab 之间留 16px（Tab 自带内边距，视觉间距更大）；再宽会让默认 1040 宽度下提权按钮收成图标。
                                padding-right: 16px;
                                Text {
                                    text: "TaskManager";
                                    vertical-alignment: center;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                }

                                Text {
                                    text: "Lite";
                                    vertical-alignment: center;
                                    font-size: 15px;
                                    font-weight: 400;
                                    color: Palette.accent-background;
                                }
                            }
                        }

                        tabs := HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Tab {
                                    text: @tr("进程");
                                    active: root.page == 0;
                                    clicked => {
                                        root.page = 0;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Tab {
                                    text: @tr("性能");
                                    active: root.page == 1;
                                    clicked => {
                                        root.page = 1;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // 右侧除提权按钮外的控件；变窄时其中只有搜索框收缩。
                    toolbar-core := HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            search := LineEdit {
                                visible: root.page == 0;
                                min-width: root.page == 0 ? root.search-floor : 0px;
                                preferred-width: root.page == 0 ? 220px : 0px;
                                max-width: root.page == 0 ? 220px : 0px;
                                // 窄于舒适宽度时换成简短占位文字，避免文字被截断。
                                placeholder-text: self.width >= root.search-comfort - 0.5px ? root.search-hint : root.search-hint-short;
                                text <=> root.filter;
                                edited(text) => {
                                    root.filter-edited(text);
                                }
                                accepted => {
                                    keys.focus();
                                }
                            }
                        }

                        if root.page == 0: VerticalLayout {
                            alignment: center;
                            SegmentedControl {
                                model: [@tr("平铺"), @tr("树形"), @tr("分组")];
                                current-index <=> root.view-mode;
                                selected(i) => {
                                    root.view-changed(i);
                                    keys.focus();
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            ComboBox {
                                width: 104px;
                                model: [@tr("0.5 秒"), @tr("1 秒"), @tr("2 秒"), @tr("暂停")];
                                current-index <=> root.interval-index;
                                selected => {
                                    root.interval-changed(self.current-index);
                                }
                            }
                        }

                        if root.page == 0: VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("结束进程");
                                enabled: root.selected >= 0;
                                clicked => {
                                    root.end-process();
                                }
                            }
                        }

                        // 迷你模式入口（性能页）：与置顶按钮同样是图标按钮。
                        if root.page == 1: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                Button {
                                    width: 100%;
                                    height: 100%;
                                    accessible-label: root.mini-text;
                                    clicked => {
                                        root.mini-mode();
                                    }
                                    Tooltip {
                                        TipBox {
                                            text: root.mini-text;
                                        }
                                    }
                                }

                                MiniIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: Palette.foreground;
                                }
                            }
                        }

                        // 置顶开关：图钉图标，置顶时换成强调色的实心图钉（按钮本身保持普通样式，避免整块强调色过于醒目）。
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                Button {
                                    width: 100%;
                                    height: 100%;
                                    accessible-label: root.pin-text;
                                    // 与“结束进程”一致不转移焦点：键盘用户 Tab 到这里后可以继续按空格切换。
                                    clicked => {
                                        root.pinned = !root.pinned;
                                    }
                                    Tooltip {
                                        TipBox {
                                            text: root.pin-text;
                                        }
                                    }
                                }

                                PinIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    tint: root.pinned ? Palette.accent-background : Palette.foreground;
                                    filled: root.pinned;
                                }
                            }
                        }
                    }

                    if !root.elevated && !root.toolbar-elevate-compact: VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.elevate-text;
                            clicked => {
                                root.elevate();
                            }
                        }
                    }

                    // 收起后的提权按钮：盾牌图标；悬停提示与无障碍名称保留完整文字。
                    if !root.elevated && root.toolbar-elevate-compact: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            Button {
                                width: 100%;
                                height: 100%;
                                accessible-label: root.elevate-text;
                                clicked => {
                                    root.elevate();
                                }
                                Tooltip {
                                    TipBox {
                                        text: root.elevate-text;
                                    }
                                }
                            }

                            ShieldIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: Palette.foreground;
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.divider;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                process-page := ProcessPage {
                    visible: root.page == 0;
                    rows: root.rows;
                    selected: root.selected;
                    sort-key: root.sort-key;
                    sort-descending: root.sort-descending;
                    filtering: root.filter != "";
                    sort-by(k) => {
                        root.sort-by(k);
                    }
                    select(i) => {
                        root.selected = i;
                        root.select(i);
                        keys.focus();
                    }
                    toggle(i) => {
                        root.toggle(i);
                    }
                    end-process => {
                        root.end-process();
                    }
                    end-tree => {
                        root.end-tree();
                    }
                }

                perf-page := PerformancePage {
                    visible: root.page == 1;
                    resources: root.resources;
                    memory: root.memory-view;
                    selected-resource: root.selected-resource;
                    selected-index: root.resource-index;
                    resource-selected(id) => {
                        root.resource-selected(id);
                    }
                    graph-resized => {
                        root.graph-resized();
                    }
                    mini-mode => {
                        root.mini-mode();
                    }
                }
            }

            Rectangle {
                height: 28px;
                background: Theme.dark ? #ffffff08 : #00000005;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 20px;
                    Text {
                        text: @tr("进程 {0}", root.process-count);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    Text {
                        text: @tr("CPU {0}", root.cpu-summary);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    Text {
                        text: @tr("内存 {0}", root.memory-summary);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    if root.interval-index == 3: Text {
                        text: @tr("已暂停刷新");
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.network;
                    }

                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                        color: root.status-kind == 1 || root.status-kind == 6 || root.status-kind == 7 ? Theme.subtle-text : Theme.danger;
                        text: root.status-kind == 1 ? @tr("已结束 {0}", root.status-arg)
                            : root.status-kind == 2 ? @tr("没有权限结束 {0}，可以以管理员身份重启后再试", root.status-arg)
                            : root.status-kind == 3 ? @tr("{0} 已经退出", root.status-arg)
                            : root.status-kind == 4 ? @tr("已取消以管理员身份重启")
                            : root.status-kind == 5 ? @tr("操作失败：{0}", root.status-arg)
                            : root.status-kind == 6 ? @tr("已复制 {0} 的路径", root.status-arg)
                            : root.status-kind == 7 ? @tr("已复制 {0} 的命令行", root.status-arg)
                            : "";
                    }
                }
            }
        }
    }

    if root.confirm-kind != 0: ConfirmDialog {
        kind: root.confirm-kind;
        name: root.confirm-name;
        descendants: root.confirm-descendants;
        includes-critical: root.confirm-critical;
        accepted => {
            root.confirm-accepted();
            keys.focus();
        }
        cancelled => {
            root.confirm-kind = 0;
            keys.focus();
        }
    }

    init => {
        keys.focus();
    }
}
