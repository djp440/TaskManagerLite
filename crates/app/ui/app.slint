import { Button, ComboBox, LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColumnLayout, ProcRow, Resource, ResourceKind, ResourceTint } from "types.slint";
import { ProcessPage, Columns, ProcessMenu } from "process-page.slint";
import { PerformancePage } from "performance-page.slint";
import { MiniWindow, OpacityChoice } from "mini-window.slint";
import { MemoryView } from "memory-detail.slint";
import { StatItem } from "stats-panel.slint";
import { SegmentedControl, ShieldIcon, TipBox } from "controls.slint";
import { Sidebar } from "sidebar.slint";
import { SettingsPage, SettingsData } from "settings-page.slint";
import { StartupPage, StartupData, StartupRow } from "startup-page.slint";
export { StartupData, StartupRow }
import { ServicesPage, ServiceData, ServiceRow } from "services-page.slint";
export { ServiceData, ServiceRow }
import { RunTaskData, RunTaskDialog } from "run-task.slint";
export { RunTaskData }
import { AffinityData, AffinityDialog, CpuBox } from "affinity.slint";
export { AffinityData, CpuBox }

export { ColumnLayout, MemoryView, ProcRow, Resource, ResourceKind, ResourceTint, StatItem, Columns, ProcessMenu, MiniWindow, OpacityChoice, SettingsData }
export { CoreGraph, CpuData, GridLayout } from "cpu-detail.slint";

// 图钉图标：窗口置顶。未置顶时描边，置顶时实心。
component PinIcon inherits Rectangle {
    in property <brush> tint;
    in property <bool> filled;
    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.filled ? root.tint : transparent;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 4.6 1.8 L 11.4 1.8 L 11.4 3.2 L 10.4 4 L 10.4 7.2 L 13 9.8 L 3 9.8 L 5.6 7.2 L 5.6 4 L 4.6 3.2 Z";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 8 9.8 L 8 14.8";
    }
}

// 迷你模式图标：大窗口的轮廓里，右上角一个实心小窗口。
component MiniIcon inherits Rectangle {
    in property <brush> tint;
    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 6.5 2.5 L 2.5 2.5 L 2.5 13.5 L 13.5 13.5 L 13.5 9.5";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 9 2 L 14 2 L 14 7 L 9 7 Z";
    }
}

// 需要用户确认的操作：1 = 结束关键进程，2 = 结束进程树，3 = 导出包含敏感列的 CSV（name 是列名），
// 4 = 把进程优先级设为“实时”（name 是进程名），5 = 对应用及其全部后代开启 / 关闭效率模式
// （name 是应用名，descendants 是受影响的进程总数，eco-on 为 true 表示开启）。
component ConfirmDialog inherits Rectangle {
    in property <int> kind;
    in property <string> name;
    in property <int> descendants;
    in property <bool> includes-critical;
    in property <bool> eco-on;
    callback accepted();
    callback cancelled();

    background: #00000066;
    TouchArea { }

    card := Rectangle {
        width: min(420px, parent.width - 48px);
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 10px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.divider;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;

        body := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text {
                text: root.kind == 5 ? (root.eco-on ? @tr("开启效率模式？") : @tr("关闭效率模式？")) : root.kind == 4 ? @tr("设为“实时”优先级？") : root.kind == 3 ? @tr("导出包含敏感信息的列？") : root.kind == 2 ? @tr("结束进程树？") : @tr("结束关键进程？");
                font-size: 18px;
                font-weight: 600;
                color: Palette.foreground;
            }

            Text {
                text: root.kind == 5
                    ? (root.eco-on
                        ? @tr("将对 {0} 及其后代共 {1} 个进程开启效率模式：它们的优先级会降为“低”，并被系统限制到节能运行，可能变慢。", root.name, root.descendants)
                        : @tr("将对 {0} 及其后代共 {1} 个进程关闭效率模式：优先级会恢复到开启前的值（手动改过优先级的进程保持不变）。", root.name, root.descendants))
                    : root.kind == 4
                    ? @tr("将 {0} 设为“实时”优先级后，它会抢占几乎所有其他进程的 CPU 时间，可能让系统失去响应甚至需要强制重启。仅在清楚后果时继续。", root.name)
                    : root.kind == 3
                    ? @tr("导出的 CSV 将包含“{0}”。这些内容可能带有密码、令牌或个人信息，请把文件保存在安全的位置，分享给别人之前先检查。", root.name)
                    : root.kind == 2
                    ? @tr("将结束 {0} 及其 {1} 个后代进程，未保存的数据会丢失。", root.name, root.descendants)
                    : @tr("{0} 是关键进程，结束它可能导致系统崩溃或注销。", root.name);
                wrap: word-wrap;
                color: Palette.foreground;
            }

            if root.kind == 2 && root.includes-critical: Text {
                text: @tr("其中包含关键进程，结束后系统可能崩溃或注销。");
                wrap: word-wrap;
                color: Theme.danger;
            }

            HorizontalLayout {
                padding-top: 8px;
                alignment: end;
                spacing: 8px;
                Button {
                    text: @tr("取消");
                    clicked => {
                        root.cancelled();
                    }
                }

                Button {
                    text: root.kind == 3 ? @tr("继续导出") : root.kind == 4 ? @tr("设为实时") : root.kind == 5 ? (root.eco-on ? @tr("开启") : @tr("关闭")) : @tr("结束");
                    primary: true;
                    clicked => {
                        root.accepted();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("任务管理器 Lite");
    icon: @image-url("../../../assets/logo.png");
    // 初始大小由 Rust 在显示前按设置写入。
    in property <length> initial-width: 1080px;
    in property <length> initial-height: 700px;
    preferred-width: root.initial-width;
    preferred-height: root.initial-height;
    min-width: 760px;
    min-height: 480px;
    always-on-top: root.pinned;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    background: Theme.surface;

    // software 渲染器的局部重绘依赖缓冲区没有被系统清掉；窗口从隐藏/最小化恢复后若缓冲区已清空，
    // 就会出现整片透明/黑色（#15）。Rust 翻转它，让下面的整窗矩形整块失效、强制整窗重绘。
    in property <bool> repaint-flip;
    in property <[ProcRow]> rows;
    in-out property <int> selected: -1;
    in property <int> sort-key: 2;
    in property <bool> sort-descending: true;
    // 视图模式：0 平铺，1 树形，2 分组。
    in-out property <int> view-mode: 0;
    in-out property <string> filter;
    in-out property <int> page: 0;
    // 侧边栏折叠偏好，由 Rust 按设置恢复，退出时保存。
    in-out property <bool> sidebar-expanded: true;
    in-out property <int> interval-index: 1;
    in property <bool> elevated;
    // 窗口置顶，由 Rust 按设置恢复，退出时保存。
    in-out property <bool> pinned;
    in property <[Resource]> resources;
    in property <MemoryView> memory-view;
    in property <int> process-count;
    in property <string> cpu-summary;
    in property <string> memory-summary;

    // 状态栏消息：1 已结束，2 权限不足，3 进程已退出，4 取消提权，5 其他错误，
    // 6 已复制路径，7 已复制命令行，8 已导出 CSV，9 已复制所选行，10 已设置优先级，11 已设置亲和性，12 效率模式已切换。
    in property <int> status-kind;
    in property <string> status-arg;

    in-out property <int> confirm-kind;
    in property <string> confirm-name;
    in property <int> confirm-descendants;
    in property <bool> confirm-critical;
    in property <bool> confirm-eco-on;

    callback select(int);
    callback sort-by(int);
    callback toggle(int);
    callback filter-edited(string);
    callback view-changed(int);
    callback interval-changed(int);
    callback end-process();
    callback end-tree();
    callback confirm-accepted();
    // 性能页“导出当前快照…”。
    callback export-snapshot();
    callback elevate();
    callback graph-resized();
    // 切换到迷你模式（性能页工具栏按钮、双击性能页左栏卡片、Ctrl+M）。
    callback mini-mode();
    // F5 在进程页与性能页：立即补采一次。
    callback refresh-now();
    // 界面事件（页面切换、搜索框焦点），Rust 写入日志，供自动化验收核对。
    callback ui-event(string);
    // 性能页选中的资源：实例 id 与它在 resources 中的下标，均由 Rust 维护。
    in property <string> selected-resource: "cpu";
    in property <int> resource-index: 0;
    callback resource-selected(string);
    out property <length> graph-width: perf-page.graph-width;
    out property <length> graph-height: perf-page.graph-height;

    // 页面导航在左侧边栏：窗口够宽且用户没有折叠时图标加文字，否则只有图标。
    out property <bool> sidebar-wide: root.sidebar-expanded && root.width >= 900px;
    out property <length> sidebar-width: root.sidebar-wide ? 160px : 48px;
    // 画面上的侧边栏宽度：折叠/展开时过渡到 sidebar-width。布局预算与测试只看目标宽度，过渡中右侧内容总比最终更宽，不会被裁。
    private property <length> sidebar-shown-width: root.sidebar-width;
    animate sidebar-shown-width {
        duration: 160ms;
        easing: ease-out;
    }
    // 工具栏随窗口变窄依次收缩：
    // 1. 搜索框从 220px 缩到“舒适宽度”，即恰好放下完整的占位文字（由布局完成）；
    // 2. 仍放不下时，“以管理员身份重启”收成盾牌图标按钮（悬停显示提示）；
    // 3. 仍放不下时收起置顶按钮（设置页里可以切换置顶）。
    // 档位按搜索框的舒适宽度判断；最窄时（约 800 以下）搜索框再缩到只放下简短占位文字。判断只用不随档位变化的量（各部分的首选/最小宽度），避免绑定循环。
    // 进程页、启动项页、服务页各有自己的搜索框（同一位置，按页面显示其一）。
    private property <bool> search-page: root.page == 0 || root.page == 3 || root.page == 4;
    private property <string> search-hint: root.page == 3 ? @tr("搜索名称或发布者（Ctrl+F）")
        : root.page == 4 ? @tr("搜索服务（Ctrl+F）")
        : @tr("搜索名称或 PID（Ctrl+F）");
    private property <string> search-hint-short: root.page == 3 ? @tr("搜索启动项")
        : root.page == 4 ? @tr("搜索服务")
        : @tr("搜索进程");
    private property <string> elevate-text: @tr("以管理员身份重启");
    private property <string> mini-text: @tr("迷你模式（Ctrl+M）");
    private property <string> pin-text: root.pinned ? @tr("取消置顶") : @tr("窗口置顶");
    // 进入设置页之前的页面：再点设置入口时回到它，在设置页里保存设置时也记录它。
    out property <int> page-before-settings: 0;
    // Fluent 输入框左右内边距各 12px，另留 4px 光标余量。
    private property <length> search-comfort: min(176px, search-measure.preferred-width + 28px);
    private property <length> search-floor: min(root.search-comfort, max(104px, search-short-measure.preferred-width + 28px));
    // 侧边栏右侧的工具栏：左右内边距 16 + 12，伸缩空白与右侧组之间一个 8px 间距。
    private property <length> toolbar-room: root.width - root.sidebar-width - 36px;
    // Fluent 按钮左右内边距各 12px；提权按钮的需求含它与左侧控件的 8px 间距。
    private property <length> elevate-text-need: root.elevated ? 0px : max(32px, elevate-measure.preferred-width + 24px) + 8px;
    private property <length> elevate-icon-need: root.elevated ? 0px : 32px + 8px;
    // 置顶按钮 32px，加上与左侧控件的 8px 间距。
    private property <length> icon-button-need: 32px + 8px;
    private property <length> toolbar-core-need: toolbar-core.min-width + (root.search-page ? root.search-comfort - root.search-floor : 0px);
    out property <bool> toolbar-elevate-compact: root.toolbar-core-need + root.icon-button-need + root.elevate-text-need > root.toolbar-room;
    private property <length> elevate-need: root.toolbar-elevate-compact ? root.elevate-icon-need : root.elevate-text-need;
    out property <bool> toolbar-pin-shown: root.toolbar-core-need + root.icon-button-need + root.elevate-need <= root.toolbar-room;
    // 截图模式与单元测试据此断言工具栏没有被挤出窗口（最小宽度不超过侧边栏右侧的宽度即没有控件被裁剪）。
    out property <length> toolbar-min-width: toolbar.min-width;

    // 供截图模式切换深浅色。
    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // 主题设置：0 跟随系统，1 浅色，2 深色。
    public function set-theme(mode: int) {
        Palette.color-scheme = mode == 1 ? ColorScheme.light : mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    // 从其他页跳转到进程页后，把选中行滚动到可见处并让列表获得键盘焦点。
    public function show-selected() {
        process-page.ensure-visible(root.selected);
        keys.focus();
    }

    function toggle-settings() {
        if root.page == 2 {
            root.page = root.page-before-settings;
        } else {
            root.page-before-settings = root.page;
            root.page = 2;
        }
    }

    // Ctrl+1…5 对应的页面编号（侧边栏顺序：进程 0、性能 1、启动项 3、服务 4、设置 2）；其他文字返回 -1。
    pure function shortcut-page(text: string) -> int {
        return text == "1" ? 0 : text == "2" ? 1 : text == "3" ? 3 : text == "4" ? 4 : text == "5" ? 2 : -1;
    }

    // 快捷键切页：进入设置页前记下来源页（与点侧边栏一致），并把焦点还给列表，避免继续留在已隐藏的搜索框里。
    function goto-page(p: int) {
        if p == 2 && root.page != 2 {
            root.page-before-settings = root.page;
        }
        root.page = p;
        keys.focus();
    }

    // Ctrl+F：聚焦当前页的搜索框并选中已有文字；没有搜索框的页面（性能、设置）跳到进程页的搜索框。
    function focus-search() {
        if root.page == 3 {
            startup-search.focus();
            startup-search.select-all();
        } else if root.page == 4 {
            services-search.focus();
            services-search.select-all();
        } else {
            root.page = 0;
            search.focus();
            search.select-all();
        }
    }

    // Esc：搜索框有焦点时清空搜索并把焦点还给列表。返回是否处理了按键。
    function clear-search() -> bool {
        if root.page == 0 && search.has-focus {
            root.filter = "";
            root.filter-edited("");
            keys.focus();
            return true;
        }
        if root.page == 3 && startup-search.has-focus {
            StartupData.filter = "";
            StartupData.filter-edited();
            keys.focus();
            return true;
        }
        if root.page == 4 && services-search.has-focus {
            ServiceData.filter = "";
            ServiceData.filter-edited();
            keys.focus();
            return true;
        }
        return false;
    }

    // Ctrl+N 与侧边栏的“运行新任务”：打开“运行新任务”对话框（已打开时不再打开第二个）。
    function open-run-task() {
        if RunTaskData.open {
            return;
        }
        RunTaskData.input = "";
        RunTaskData.error = "";
        RunTaskData.as-admin = false;
        RunTaskData.open = true;
        root.ui-event("run-task open");
        RunTaskData.opened();
    }

    // 关闭“运行新任务”对话框并把焦点还给列表（取消、Esc，或 Rust 在启动成功后调用）。
    public function close-run-task() {
        RunTaskData.open = false;
        root.ui-event("run-task close");
        keys.focus();
    }

    // 关闭“设置亲和性”对话框并把焦点还给列表（取消、Esc，或 Rust 在应用成功后调用）。
    public function close-affinity() {
        AffinityData.open = false;
        root.ui-event("affinity close");
        keys.focus();
    }

    // F5：复用各页面进入时的刷新入口；进程页与性能页立即补采一次。
    function refresh-page() {
        root.ui-event("refresh page=\{root.page}");
        if root.page == 3 {
            StartupData.refresh();
        } else if root.page == 4 {
            ServiceData.refresh();
        } else if root.page == 2 {
            SettingsData.refresh();
        } else {
            root.refresh-now();
        }
    }

    function move-selection(delta: int) {
        if root.rows.length == 0 {
            return;
        }
        // 分组标题行不可选：落在标题行上就沿移动方向再走一格（标题行之间总隔着进程行，不会连续出现）。
        let base = max(0, min(root.rows.length - 1, root.selected + delta));
        root.selected = !root.rows[base].header ? base
            : delta < 0 ? (base > 0 ? base - 1 : base + 1)
            : (base + 1 < root.rows.length ? base + 1 : base - 1);
        root.select(root.selected);
        process-page.ensure-visible(root.selected);
    }

    // 整窗兜底重绘（见 repaint-flip）：x 偏移 0.01px 肉眼不可见，但每次翻转都会让整窗区域失效。
    Rectangle {
        x: root.repaint-flip ? 0px : 0.01px;
        width: root.width;
        height: root.height;
        background: Theme.surface;
    }

    keys := FocusScope {
        key-pressed(event) => {
            if root.confirm-kind != 0 {
                if event.text == Key.Escape {
                    root.confirm-kind = 0;
                    return accept;
                }
                return reject;
            }
            if AffinityData.open {
                if event.text == Key.Escape {
                    root.close-affinity();
                    return accept;
                }
                return reject;
            }
            if RunTaskData.open {
                // 对话框自己的输入框处理按键；焦点意外留在这里时 Esc 仍能关闭它。
                if event.text == Key.Escape {
                    root.close-run-task();
                    return accept;
                }
                return reject;
            }
            if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.open-run-task();
                return accept;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                root.focus-search();
                return accept;
            }
            // Ctrl+C：进程页复制所选行。搜索框有焦点时留给文本框自己复制所选文字。
            if event.modifiers.control && (event.text == "c" || event.text == "C") && root.page == 0 && !search.has-focus {
                ProcessMenu.copy-row();
                return accept;
            }
            if event.modifiers.control && (event.text == "m" || event.text == "M") {
                root.mini-mode();
                return accept;
            }
            // 只有按着 Ctrl 才切页：在搜索框里输入的数字由文本框自己处理，不会冒泡到这里。
            if event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && root.shortcut-page(event.text) >= 0 {
                root.goto-page(root.shortcut-page(event.text));
                return accept;
            }
            if event.text == Key.F5 {
                root.refresh-page();
                return accept;
            }
            if event.text == Key.Escape && root.clear-search() {
                return accept;
            }
            if root.page != 0 {
                return reject;
            }
            if event.text == Key.Delete {
                root.end-process();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.move-selection(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-selection(-1);
                return accept;
            }
            if event.text == Key.PageDown {
                root.move-selection(15);
                return accept;
            }
            if event.text == Key.PageUp {
                root.move-selection(-15);
                return accept;
            }
            reject
        }

        VerticalLayout {
            // 侧边栏与右侧内容用显式位置排布，而不是 HorizontalLayout：侧边栏宽度取决于窗口宽度，
            // 放进布局会让“侧边栏宽度 → 窗口布局约束 → 窗口宽度 → 侧边栏宽度”形成绑定循环。
            Rectangle {
                vertical-stretch: 1;
                Sidebar {
                    x: 0px;
                    y: 0px;
                    width: root.sidebar-shown-width;
                    height: parent.height;
                    page: root.page;
                    wide: root.sidebar-wide;
                    can-toggle: root.width >= 900px;
                    page-selected(p) => {
                        root.page = p;
                    }
                    run-clicked => {
                        root.open-run-task();
                    }
                    settings-clicked => {
                        root.toggle-settings();
                    }
                    toggle-clicked => {
                        root.sidebar-expanded = !root.sidebar-expanded;
                    }
                }

                VerticalLayout {
                    x: root.sidebar-shown-width;
                    y: 0px;
                    width: parent.width - root.sidebar-shown-width;
                    height: parent.height;
                    Rectangle {
                        height: 56px;
                        // 只用于测量宽度的隐藏文字，字体字号与搜索框占位文字、按钮文字相同。
                        // 子元素都显式定位：这样它们的尺寸约束不会传给窗口，否则“档位 → 工具栏最小宽度 →
                        // 窗口布局约束 → 窗口宽度 → 档位”会形成绑定循环。
                        search-measure := Text {
                            x: 0px;
                            y: 0px;
                            visible: false;
                            text: root.search-hint;
                        }

                        search-short-measure := Text {
                            x: 0px;
                            y: 0px;
                            visible: false;
                            text: root.search-hint-short;
                        }

                        elevate-measure := Text {
                            x: 0px;
                            y: 0px;
                            visible: false;
                            text: root.elevate-text;
                        }

                        toolbar := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 8px;

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            // 右侧除提权按钮外的控件；变窄时其中只有搜索框收缩。
                            toolbar-core := HorizontalLayout {
                                horizontal-stretch: 0;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    // 三个搜索框叠在同一位置，按页面显示其一（元素 id 不能在 if 之外引用，所以用 visible 切换）。
                                    Rectangle {
                                        min-width: root.search-page ? root.search-floor : 0px;
                                        preferred-width: root.search-page ? 220px : 0px;
                                        max-width: root.search-page ? 220px : 0px;
                                        height: search.preferred-height;
                                        search := LineEdit {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width;
                                            height: parent.height;
                                            visible: root.page == 0;
                                            // 窄于舒适宽度时换成简短占位文字，避免文字被截断。
                                            placeholder-text: self.width >= 219.5px ? root.search-hint : root.search-hint-short;
                                            text <=> root.filter;
                                            edited(text) => {
                                                root.filter-edited(text);
                                            }
                                            accepted => {
                                                keys.focus();
                                            }
                                            changed has-focus => {
                                                root.ui-event("search-focus page=0 focused=" + (self.has-focus ? "1" : "0"));
                                            }
                                        }

                                        startup-search := LineEdit {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width;
                                            height: parent.height;
                                            visible: root.page == 3;
                                            placeholder-text: self.width >= 219.5px ? root.search-hint : root.search-hint-short;
                                            text <=> StartupData.filter;
                                            edited(text) => {
                                                StartupData.filter-edited();
                                            }
                                            accepted => {
                                                keys.focus();
                                            }
                                            changed has-focus => {
                                                root.ui-event("search-focus page=3 focused=" + (self.has-focus ? "1" : "0"));
                                            }
                                        }

                                        services-search := LineEdit {
                                            x: 0px;
                                            y: 0px;
                                            width: parent.width;
                                            height: parent.height;
                                            visible: root.page == 4;
                                            placeholder-text: self.width >= 219.5px ? root.search-hint : root.search-hint-short;
                                            text <=> ServiceData.filter;
                                            edited(text) => {
                                                ServiceData.filter-edited();
                                            }
                                            accepted => {
                                                keys.focus();
                                            }
                                            changed has-focus => {
                                                root.ui-event("search-focus page=4 focused=" + (self.has-focus ? "1" : "0"));
                                            }
                                        }
                                    }
                                }

                                if root.page == 0: VerticalLayout {
                                    alignment: center;
                                    SegmentedControl {
                                        model: [@tr("平铺"), @tr("树形"), @tr("分组")];
                                        current-index <=> root.view-mode;
                                        selected(i) => {
                                            root.view-changed(i);
                                            keys.focus();
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    ComboBox {
                                        width: 96px;
                                        model: [@tr("0.5 秒"), @tr("1 秒"), @tr("2 秒"), @tr("暂停")];
                                        current-index <=> root.interval-index;
                                        selected => {
                                            root.interval-changed(self.current-index);
                                        }
                                    }
                                }

                                if root.page == 0: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: @tr("结束进程");
                                        enabled: root.selected >= 0;
                                        clicked => {
                                            root.end-process();
                                        }
                                    }
                                }

                                // 迷你模式入口（性能页）：与置顶按钮同样是图标按钮。
                                if root.page == 1: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        Button {
                                            width: 100%;
                                            height: 100%;
                                            accessible-label: root.mini-text;
                                            clicked => {
                                                root.mini-mode();
                                            }
                                            Tooltip {
                                                TipBox {
                                                    text: root.mini-text;
                                                }
                                            }
                                        }

                                        MiniIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            tint: Palette.foreground;
                                        }
                                    }
                                }
                            }

                            // 置顶开关：图钉图标，置顶时换成强调色的实心图钉（按钮本身保持普通样式，避免整块强调色过于醒目）。
                            // 最窄时收起（设置页里仍可切换置顶）。
                            if root.toolbar-pin-shown: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    Button {
                                        width: 100%;
                                        height: 100%;
                                        accessible-label: root.pin-text;
                                        // 与“结束进程”一致不转移焦点：键盘用户 Tab 到这里后可以继续按空格切换。
                                        clicked => {
                                            root.pinned = !root.pinned;
                                        }
                                        Tooltip {
                                            TipBox {
                                                text: root.pin-text;
                                            }
                                        }
                                    }

                                    PinIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: root.pinned ? Palette.accent-background : Palette.foreground;
                                        filled: root.pinned;
                                    }
                                }
                            }

                            if !root.elevated && !root.toolbar-elevate-compact: VerticalLayout {
                                alignment: center;
                                Button {
                                    text: root.elevate-text;
                                    clicked => {
                                        root.elevate();
                                    }
                                }
                            }

                            // 收起后的提权按钮：盾牌图标；悬停提示与无障碍名称保留完整文字。
                            if !root.elevated && root.toolbar-elevate-compact: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    Button {
                                        width: 100%;
                                        height: 100%;
                                        accessible-label: root.elevate-text;
                                        clicked => {
                                            root.elevate();
                                        }
                                        Tooltip {
                                            TipBox {
                                                text: root.elevate-text;
                                            }
                                        }
                                    }

                                    ShieldIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        tint: Palette.foreground;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.divider;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        process-page := ProcessPage {
                            visible: root.page == 0;
                            rows: root.rows;
                            selected: root.selected;
                            sort-key: root.sort-key;
                            sort-descending: root.sort-descending;
                            filtering: root.filter != "";
                            sort-by(k) => {
                                root.sort-by(k);
                            }
                            select(i) => {
                                root.selected = i;
                                root.select(i);
                                keys.focus();
                            }
                            toggle(i) => {
                                root.toggle(i);
                            }
                            end-process => {
                                root.end-process();
                            }
                            end-tree => {
                                root.end-tree();
                            }
                        }

                        perf-page := PerformancePage {
                            visible: root.page == 1;
                            resources: root.resources;
                            memory: root.memory-view;
                            selected-resource: root.selected-resource;
                            selected-index: root.resource-index;
                            resource-selected(id) => {
                                root.resource-selected(id);
                            }
                            graph-resized => {
                                root.graph-resized();
                            }
                            mini-mode => {
                                root.mini-mode();
                            }
                            export-snapshot => {
                                root.export-snapshot();
                            }
                        }

                        if root.page == 3: StartupPage { }
                        if root.page == 4: ServicesPage { }
                        if root.page == 2: SettingsPage {
                            elevated: root.elevated;
                            pinned <=> root.pinned;
                            interval-index <=> root.interval-index;
                            interval-changed(i) => {
                                root.interval-changed(i);
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 28px;
                background: Theme.dark ? #ffffff08 : #00000005;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 20px;
                    Text {
                        text: @tr("进程 {0}", root.process-count);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    Text {
                        text: @tr("CPU {0}", root.cpu-summary);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    Text {
                        text: @tr("内存 {0}", root.memory-summary);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    if root.interval-index == 3: Text {
                        text: @tr("已暂停刷新");
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.network;
                    }

                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                        color: root.status-kind == 1 || (root.status-kind >= 6 && root.status-kind <= 12) ? Theme.subtle-text : Theme.danger;
                        text: root.status-kind == 1 ? @tr("已结束 {0}", root.status-arg)
                            : root.status-kind == 2 ? @tr("没有权限结束 {0}，可以以管理员身份重启后再试", root.status-arg)
                            : root.status-kind == 3 ? @tr("{0} 已经退出", root.status-arg)
                            : root.status-kind == 4 ? @tr("已取消以管理员身份重启")
                            : root.status-kind == 5 ? @tr("操作失败：{0}", root.status-arg)
                            : root.status-kind == 6 ? @tr("已复制 {0} 的路径", root.status-arg)
                            : root.status-kind == 7 ? @tr("已复制 {0} 的命令行", root.status-arg)
                            : root.status-kind == 8 ? @tr("已导出到 {0}", root.status-arg)
                            : root.status-kind == 9 ? @tr("已复制 {0} 的行", root.status-arg)
                            : root.status-kind == 10 ? @tr("已设置优先级：{0}", root.status-arg)
                            : root.status-kind == 11 ? @tr("已设置亲和性：{0}", root.status-arg)
                            : root.status-kind == 12 ? @tr("效率模式：{0}", root.status-arg)
                            : "";
                    }
                }
            }
        }
    }

    if root.confirm-kind != 0: ConfirmDialog {
        kind: root.confirm-kind;
        name: root.confirm-name;
        descendants: root.confirm-descendants;
        includes-critical: root.confirm-critical;
        eco-on: root.confirm-eco-on;
        accepted => {
            root.confirm-accepted();
            keys.focus();
        }
        cancelled => {
            root.confirm-kind = 0;
            keys.focus();
        }
    }

    if RunTaskData.open: RunTaskDialog {
        cancelled => {
            root.close-run-task();
        }
    }

    if AffinityData.open: AffinityDialog {
        cancelled => {
            root.close-affinity();
        }
    }

    changed page => {
        root.ui-event("page=\{root.page}");
    }

    init => {
        keys.focus();
    }
}
