import { Button, CheckBox, ComboBox, LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ProcRow, Resource, ResourceKind, ResourceTint } from "types.slint";
import { ProcessPage } from "process-page.slint";
import { PerformancePage } from "performance-page.slint";

export { ProcRow, Resource, ResourceKind, ResourceTint }
export { CoreGraph, CpuData, InfoRow } from "cpu-detail.slint";

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    height: 34px;
    border-radius: 6px;
    background: touch.has-hover && !root.active ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Palette.foreground : Theme.subtle-text;
        }
    }

    Rectangle {
        y: parent.height - 3px;
        x: (parent.width - self.width) / 2;
        width: root.active ? 18px : 0px;
        height: 3px;
        border-radius: 1.5px;
        background: Palette.accent-background;
        animate width { duration: 150ms; easing: ease-out; }
    }
}

// 需要用户确认的操作：1 = 结束关键进程，2 = 结束进程树。
component ConfirmDialog inherits Rectangle {
    in property <int> kind;
    in property <string> name;
    in property <int> descendants;
    in property <bool> includes-critical;
    callback accepted();
    callback cancelled();

    background: #00000066;
    TouchArea { }

    card := Rectangle {
        width: min(420px, parent.width - 48px);
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 10px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.divider;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;

        body := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text {
                text: root.kind == 2 ? @tr("结束进程树？") : @tr("结束关键进程？");
                font-size: 18px;
                font-weight: 600;
                color: Palette.foreground;
            }

            Text {
                text: root.kind == 2
                    ? @tr("将结束 {0} 及其 {1} 个后代进程，未保存的数据会丢失。", root.name, root.descendants)
                    : @tr("{0} 是关键进程，结束它可能导致系统崩溃或注销。", root.name);
                wrap: word-wrap;
                color: Palette.foreground;
            }

            if root.kind == 2 && root.includes-critical: Text {
                text: @tr("其中包含关键进程，结束后系统可能崩溃或注销。");
                wrap: word-wrap;
                color: Theme.danger;
            }

            HorizontalLayout {
                padding-top: 8px;
                alignment: end;
                spacing: 8px;
                Button {
                    text: @tr("取消");
                    clicked => {
                        root.cancelled();
                    }
                }

                Button {
                    text: @tr("结束");
                    primary: true;
                    clicked => {
                        root.accepted();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("任务管理器 Lite");
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 480px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    background: Theme.surface;

    in property <[ProcRow]> rows;
    in-out property <int> selected: -1;
    in property <int> sort-key: 2;
    in property <bool> sort-descending: true;
    in-out property <bool> tree-mode;
    in-out property <string> filter;
    in-out property <int> page: 0;
    in-out property <int> interval-index: 1;
    in property <bool> elevated;
    in property <[Resource]> resources;
    in property <int> process-count;
    in property <string> cpu-summary;
    in property <string> memory-summary;

    // 状态栏消息：1 已结束，2 权限不足，3 进程已退出，4 取消提权，5 其他错误。
    in property <int> status-kind;
    in property <string> status-arg;

    in-out property <int> confirm-kind;
    in property <string> confirm-name;
    in property <int> confirm-descendants;
    in property <bool> confirm-critical;

    callback select(int);
    callback sort-by(int);
    callback toggle(int);
    callback filter-edited(string);
    callback tree-changed(bool);
    callback interval-changed(int);
    callback end-process();
    callback end-tree();
    callback confirm-accepted();
    callback elevate();
    callback graph-resized();
    // 性能页选中的资源：实例 id 与它在 resources 中的下标，均由 Rust 维护。
    in property <string> selected-resource: "cpu";
    in property <int> resource-index: 0;
    callback resource-selected(string);
    out property <length> graph-width: perf-page.graph-width;
    out property <length> graph-height: perf-page.graph-height;

    // 供截图模式切换深浅色。
    public function set-dark(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    function move-selection(delta: int) {
        if root.rows.length == 0 {
            return;
        }
        root.selected = max(0, min(root.rows.length - 1, root.selected + delta));
        root.select(root.selected);
        process-page.ensure-visible(root.selected);
    }

    keys := FocusScope {
        key-pressed(event) => {
            if root.confirm-kind != 0 {
                if event.text == Key.Escape {
                    root.confirm-kind = 0;
                    return accept;
                }
                return reject;
            }
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                root.page = 0;
                search.focus();
                return accept;
            }
            if root.page != 0 {
                return reject;
            }
            if event.text == Key.Delete {
                root.end-process();
                return accept;
            }
            if event.text == Key.DownArrow {
                root.move-selection(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-selection(-1);
                return accept;
            }
            if event.text == Key.PageDown {
                root.move-selection(15);
                return accept;
            }
            if event.text == Key.PageUp {
                root.move-selection(-15);
                return accept;
            }
            reject
        }

        VerticalLayout {
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        text: "TaskManager";
                        vertical-alignment: center;
                        font-size: 15px;
                        font-weight: 700;
                        color: Palette.foreground;
                    }

                    Text {
                        text: "Lite";
                        vertical-alignment: center;
                        font-size: 15px;
                        font-weight: 400;
                        color: Palette.accent-background;
                    }

                    Rectangle {
                        width: 16px;
                    }

                    VerticalLayout {
                        alignment: center;
                        Tab {
                            text: @tr("进程");
                            active: root.page == 0;
                            clicked => {
                                root.page = 0;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Tab {
                            text: @tr("性能");
                            active: root.page == 1;
                            clicked => {
                                root.page = 1;
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        search := LineEdit {
                            visible: root.page == 0;
                            width: root.page == 0 ? 220px : 0px;
                            placeholder-text: @tr("搜索名称或 PID（Ctrl+F）");
                            text <=> root.filter;
                            edited(text) => {
                                root.filter-edited(text);
                            }
                            accepted => {
                                keys.focus();
                            }
                        }
                    }

                    if root.page == 0: CheckBox {
                        text: @tr("树形");
                        checked <=> root.tree-mode;
                        toggled => {
                            root.tree-changed(self.checked);
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        ComboBox {
                            width: 104px;
                            model: [@tr("0.5 秒"), @tr("1 秒"), @tr("2 秒"), @tr("暂停")];
                            current-index <=> root.interval-index;
                            selected => {
                                root.interval-changed(self.current-index);
                            }
                        }
                    }

                    if root.page == 0: VerticalLayout {
                        alignment: center;
                        Button {
                            text: @tr("结束进程");
                            enabled: root.selected >= 0;
                            clicked => {
                                root.end-process();
                            }
                        }
                    }

                    if !root.elevated: VerticalLayout {
                        alignment: center;
                        Button {
                            text: @tr("以管理员身份重启");
                            clicked => {
                                root.elevate();
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.divider;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                process-page := ProcessPage {
                    visible: root.page == 0;
                    rows: root.rows;
                    selected: root.selected;
                    sort-key: root.sort-key;
                    sort-descending: root.sort-descending;
                    filtering: root.filter != "";
                    sort-by(k) => {
                        root.sort-by(k);
                    }
                    select(i) => {
                        root.selected = i;
                        root.select(i);
                        keys.focus();
                    }
                    toggle(i) => {
                        root.toggle(i);
                    }
                    end-process => {
                        root.end-process();
                    }
                    end-tree => {
                        root.end-tree();
                    }
                }

                perf-page := PerformancePage {
                    visible: root.page == 1;
                    resources: root.resources;
                    selected-resource: root.selected-resource;
                    selected-index: root.resource-index;
                    resource-selected(id) => {
                        root.resource-selected(id);
                    }
                    graph-resized => {
                        root.graph-resized();
                    }
                }
            }

            Rectangle {
                height: 28px;
                background: Theme.dark ? #ffffff08 : #00000005;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.divider;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 20px;
                    Text {
                        text: @tr("进程 {0}", root.process-count);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    Text {
                        text: @tr("CPU {0}", root.cpu-summary);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    Text {
                        text: @tr("内存 {0}", root.memory-summary);
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    if root.interval-index == 3: Text {
                        text: @tr("已暂停刷新");
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.network;
                    }

                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                        color: root.status-kind == 1 ? Theme.subtle-text : Theme.danger;
                        text: root.status-kind == 1 ? @tr("已结束 {0}", root.status-arg)
                            : root.status-kind == 2 ? @tr("没有权限结束 {0}，可以以管理员身份重启后再试", root.status-arg)
                            : root.status-kind == 3 ? @tr("{0} 已经退出", root.status-arg)
                            : root.status-kind == 4 ? @tr("已取消以管理员身份重启")
                            : root.status-kind == 5 ? @tr("操作失败：{0}", root.status-arg)
                            : "";
                    }
                }
            }
        }
    }

    if root.confirm-kind != 0: ConfirmDialog {
        kind: root.confirm-kind;
        name: root.confirm-name;
        descendants: root.confirm-descendants;
        includes-critical: root.confirm-critical;
        accepted => {
            root.confirm-accepted();
            keys.focus();
        }
        cancelled => {
            root.confirm-kind = 0;
            keys.focus();
        }
    }

    init => {
        keys.focus();
    }
}
