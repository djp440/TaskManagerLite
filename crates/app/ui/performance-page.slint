import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Resource, ResourceKind, ResourceTint } from "types.slint";
import { MemoryDetail, MemoryView } from "memory-detail.slint";

// 资源曲线：路径由 Rust 按图表的实际尺寸（逻辑像素）生成。
component Graph inherits Rectangle {
    in property <string> line;
    in property <string> area;
    in property <color> tint;
    in property <bool> grid;

    clip: true;
    if root.grid: Rectangle {
        for i in 3: Rectangle {
            y: parent.height * (i + 1) / 4;
            height: 1px;
            background: Theme.grid;
        }
        for i in 5: Rectangle {
            x: parent.width * (i + 1) / 6;
            width: 1px;
            background: Theme.grid;
        }
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.area;
        fill: root.tint.with-alpha(0.16);
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.line;
        stroke: root.tint;
        stroke-width: 1.5px;
    }
}

component ResourceCard inherits Rectangle {
    in property <Resource> data;
    in property <color> tint;
    in property <bool> active;
    callback clicked;

    height: 64px;
    border-radius: Theme.radius;
    background: root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 72px;
            border-width: 1px;
            border-color: root.tint.with-alpha(0.6);
            Graph {
                line: root.data.mini-line;
                area: root.data.mini-area;
                tint: root.tint;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.title;
                font-size: 14px;
                font-weight: 600;
                color: Palette.foreground;
            }

            Text {
                text: root.data.value;
                font-size: 12px;
                color: Theme.subtle-text;
                overflow: elide;
            }
        }
    }
}

export component PerformancePage inherits Rectangle {
    in property <[Resource]> resources;
    // 选中的资源：实例 id 与它在 resources 中的下标，均由 Rust 维护。
    in property <string> selected-resource;
    in property <int> selected-index;
    callback resource-selected(string);
    // 内存详情页的数据（kind == memory 时使用）。
    in property <MemoryView> memory;
    out property <length> graph-width: detail-graph.width;
    out property <length> graph-height: detail-graph.height;
    callback graph-resized();

    changed graph-width => {
        root.graph-resized();
    }
    changed graph-height => {
        root.graph-resized();
    }

    pure function tint-of(t: ResourceTint) -> color {
        if t == ResourceTint.memory {
            return Theme.memory;
        }
        if t == ResourceTint.disk {
            return Theme.disk;
        }
        if t == ResourceTint.network {
            return Theme.network;
        }
        return Theme.cpu;
    }

    property <Resource> data: root.resources[root.selected-index];
    property <color> tint: root.tint-of(root.data.tint);

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        VerticalLayout {
            width: 240px;
            spacing: 4px;
            alignment: start;
            for r in root.resources: ResourceCard {
                data: r;
                tint: root.tint-of(r.tint);
                active: r.id == root.selected-resource;
                clicked => {
                    root.resource-selected(r.id);
                }
            }
        }

        Rectangle {
            border-radius: Theme.radius;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.divider;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: root.data.title;
                        font-size: 24px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: bottom;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.detail;
                        horizontal-alignment: right;
                        vertical-alignment: bottom;
                        color: Theme.subtle-text;
                    }
                }

                HorizontalLayout {
                    Text {
                        text: root.data.caption;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.scale;
                        horizontal-alignment: right;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 160px;
                    border-width: 1px;
                    border-color: root.tint.with-alpha(0.55);
                    detail-graph := Graph {
                        line: root.data.line;
                        area: root.data.area;
                        tint: root.tint;
                        grid: true;
                    }
                }

                HorizontalLayout {
                    Text {
                        text: @tr("60 秒");
                        font-size: 12px;
                        color: Theme.faint-text;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: "0";
                        horizontal-alignment: right;
                        font-size: 12px;
                        color: Theme.faint-text;
                    }
                }

                // 详情区目前对所有类型通用；需要按类型定制时（CPU、内存等），
                // 在这里按 root.data.kind 分支，并让通用统计项排除这些类型。
                if root.data.kind == ResourceKind.memory: MemoryDetail {
                    view: root.memory;
                    tint: root.tint;
                }

                if root.data.kind != ResourceKind.memory: HorizontalLayout {
                    padding-top: 8px;
                    spacing: 40px;
                    alignment: start;
                    for value[i] in root.data.stats: VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: root.data.stat-labels[i];
                            font-size: 12px;
                            color: Theme.subtle-text;
                        }

                        Text {
                            text: value;
                            font-size: 20px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                    }
                }
            }
        }
    }
}
