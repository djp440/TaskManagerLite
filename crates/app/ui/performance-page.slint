import { Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Resource, ResourceKind, ResourceTint } from "types.slint";
import { MemoryDetail, MemoryView } from "memory-detail.slint";
import { CpuCoreGrid, CpuData, CpuDetail, CpuModeSwitch } from "cpu-detail.slint";

// 资源曲线：路径由 Rust 按图表的实际尺寸（逻辑像素）生成。
component Graph inherits Rectangle {
    in property <string> line;
    in property <string> area;
    in property <color> tint;
    in property <bool> grid;

    clip: true;
    if root.grid: Rectangle {
        for i in 3: Rectangle {
            y: parent.height * (i + 1) / 4;
            height: 1px;
            background: Theme.grid;
        }
        for i in 5: Rectangle {
            x: parent.width * (i + 1) / 6;
            width: 1px;
            background: Theme.grid;
        }
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.area;
        fill: root.tint.with-alpha(0.16);
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.line;
        stroke: root.tint;
        stroke-width: 1.5px;
    }
}

// 资源卡片：性能页左栏与迷你模式共用。
export component ResourceCard inherits Rectangle {
    in property <Resource> data;
    in property <color> tint;
    in property <bool> active;
    // 迷你模式：按住移动一小段距离即开始拖动窗口。
    in property <bool> draggable;
    callback clicked;
    callback double-clicked;
    callback drag-started;
    // 右键按下，参数为窗口内坐标。
    callback context-menu(length, length);

    height: 64px;
    border-radius: Theme.radius;
    background: root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
        moved => {
            if root.draggable && self.pressed && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.drag-started();
            }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 72px;
            border-width: 1px;
            border-color: root.tint.with-alpha(0.6);
            Graph {
                line: root.data.mini-line;
                area: root.data.mini-area;
                tint: root.tint;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.title;
                font-size: 14px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }

            if root.data.kind == ResourceKind.network: Text {
                text: root.data.adapter-name;
                font-size: 12px;
                color: Palette.foreground;
                overflow: elide;
            }

            Text {
                text: root.data.value;
                font-size: 12px;
                color: Theme.subtle-text;
                overflow: elide;
            }
        }
    }
}

export component PerformancePage inherits Rectangle {
    in property <[Resource]> resources;
    // 选中的资源：实例 id 与它在 resources 中的下标，均由 Rust 维护。
    in property <string> selected-resource;
    in property <int> selected-index;
    callback resource-selected(string);
    // 双击左栏卡片：切换到迷你模式。
    callback mini-mode();
    // 内存详情页的数据（kind == memory 时使用）。
    in property <MemoryView> memory;
    out property <length> graph-width: detail-graph.width;
    out property <length> graph-height: detail-graph.height;
    callback graph-resized();

    changed graph-width => {
        root.graph-resized();
    }
    changed graph-height => {
        root.graph-resized();
    }

    property <Resource> data: root.resources[root.selected-index];
    property <color> tint: Theme.resource-tint(root.data.tint);
    // CPU 页切换到“逻辑处理器”视图时，整体曲线被网格盖住。
    property <bool> core-grid: root.data.kind == ResourceKind.cpu && CpuData.per-core;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        ScrollView {
            width: 240px;
            content-width: self.visible-width;
            VerticalLayout {
            spacing: 4px;
            alignment: start;
            for r in root.resources: ResourceCard {
                data: r;
                tint: Theme.resource-tint(r.tint);
                active: r.id == root.selected-resource;
                clicked => {
                    root.resource-selected(r.id);
                }
                double-clicked => {
                    root.mini-mode();
                }
            }
        }
        }

        Rectangle {
            border-radius: Theme.radius;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.divider;

            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: root.data.title;
                        font-size: 24px;
                        font-weight: 600;
                        color: Palette.foreground;
                        vertical-alignment: bottom;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.kind == ResourceKind.network ? root.data.adapter-description : root.data.detail;
                        overflow: elide;
                        horizontal-alignment: right;
                        vertical-alignment: bottom;
                        color: Theme.subtle-text;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: root.data.caption;
                        font-size: 12px;
                        color: Theme.subtle-text;
                        vertical-alignment: center;
                    }

                    if root.data.kind == ResourceKind.cpu: CpuModeSwitch { }

                    Text {
                        horizontal-stretch: 1;
                        text: root.data.scale;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 80px;
                    border-width: root.core-grid ? 0px : 1px;
                    border-color: root.tint.with-alpha(0.55);
                    detail-graph := Graph {
                        line: root.data.line;
                        area: root.data.area;
                        tint: root.tint;
                        grid: true;
                    }

                    if root.core-grid: CpuCoreGrid { }
                }

                HorizontalLayout {
                    Text {
                        text: @tr("60 秒");
                        font-size: 12px;
                        color: Theme.faint-text;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: "0";
                        horizontal-alignment: right;
                        font-size: 12px;
                        color: Theme.faint-text;
                    }
                }

                if root.data.kind == ResourceKind.gpu: VerticalLayout {
                    spacing: 4px;
                    for line[i] in root.data.gpu-lines: VerticalLayout {
                        Text {
                            text: (i == 0 ? "专用显存" : "共享显存") + " · " + root.data.gpu-scales[i];
                            color: Theme.subtle-text;
                            font-size: 12px;
                        }
                        Graph { height: 64px; line: line; tint: root.tint; grid: true; }
                    }
                }
                // 详情区目前对所有类型通用；需要按类型定制时（CPU、内存等），
                // 在这里按 root.data.kind 分支，并让通用统计项排除这些类型。
                if root.data.kind == ResourceKind.memory: MemoryDetail {
                    view: root.memory;
                    tint: root.tint;
                }

                if root.data.kind == ResourceKind.cpu: CpuDetail { }

                if root.data.kind != ResourceKind.memory && root.data.kind != ResourceKind.cpu: HorizontalLayout {
                    padding-top: 8px;
                    spacing: 20px;
                    alignment: start;
                    for value[i] in root.data.stats: VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: root.data.stat-labels[i];
                            font-size: 12px;
                            color: Theme.subtle-text;
                        }

                        Text {
                            text: value;
                            font-size: 18px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                    }
                }
                if root.data.kind == ResourceKind.disk || root.data.kind == ResourceKind.network: Text {
                    text: root.data.kind == ResourceKind.network ? root.data.detail : root.data.disk-info;
                    wrap: word-wrap;
                    color: Theme.subtle-text;
                    font-size: 12px;
                }
                if root.data.kind == ResourceKind.disk: ScrollView {
                    max-height: 112px;
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 6px;
                        for volume in root.data.volumes: Text {
                            text: volume;
                            wrap: word-wrap;
                            color: Palette.foreground;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}
