export struct ProcRow {
    name: string,
    pid: int,
    cpu: string,
    memory: string,
    disk: string,
    cpu-heat: float,
    memory-heat: float,
    disk-heat: float,
    depth: int,
    has-children: bool,
    expanded: bool,
    critical: bool,
    // 分组视图的标题行（名称里是“应用 (5)”这样的标题文字），不可选中。
    header: bool,
    icon: image,
    // 显示中的“详细信息”列的单元格文字，与 Columns.extra 一一对应。
    extra: [string],
}

// 进程列表各数值列的有效宽度。
export struct ColumnLayout {
    pid: length,
    cpu: length,
    memory: length,
    disk: length,
}

// 显示中的一个“详细信息”列。
export struct DetailHeader {
    title: string,
    width: length,
    // 数值列右对齐，文字列左对齐。
    right: bool,
    // 排序编号：100 + 该列在全部可选列中的序号。
    sort: int,
}

// 列选择菜单中的一项（全部可选列，按固定顺序）。
export struct DetailChoice {
    title: string,
    shown: bool,
}

// 资源类型：右侧详情区按类型分支，便于为某类资源定制详情。
export enum ResourceKind {
    cpu,
    memory,
    disk,
    network,
}

// 配色类型：对应 Theme 中的资源色。
export enum ResourceTint {
    cpu,
    memory,
    disk,
    network,
}

// 性能概览中的一张资源卡片。元数据（id、类型、标题、说明、统计项标签）随数据一起由 Rust 提供。
export struct Resource {
    // 稳定的实例 id，选中状态按它保持。
    id: string,
    kind: ResourceKind,
    tint: ResourceTint,
    title: string,
    caption: string,
    stat-labels: [string],
    value: string,
    detail: string,
    line: string,
    area: string,
    mini-line: string,
    mini-area: string,
    scale: string,
    stats: [string],
}
