import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

// 分段选择：一组互斥的选项并排显示，当前项高亮。
export component SegmentedControl inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected(int);

    height: 30px;
    width: row.preferred-width;
    border-radius: 7px;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.divider;

    row := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for label[i] in root.model: Rectangle {
            width: caption.preferred-width + 20px;
            border-radius: 5px;
            background: i == root.current-index ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
            touch := TouchArea {
                clicked => {
                    root.current-index = i;
                    root.selected(i);
                }
            }

            caption := Text {
                text: label;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-weight: i == root.current-index ? 600 : 400;
                color: i == root.current-index ? Palette.foreground : Theme.subtle-text;
            }
        }
    }
}

// 盾牌图标：表示需要管理员权限的操作（与 Windows 的 UAC 盾牌同义），左半实心、右半描边。
export component ShieldIcon inherits Rectangle {
    in property <brush> tint;
    width: 16px;
    height: 16px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.tint;
        commands: "M 8 1.6 L 8 14.6 C 4.9 13.7 2.6 11 2.6 7.6 L 2.6 3.6 Z";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.tint;
        stroke-width: 1.3px;
        commands: "M 8 1.6 L 13.4 3.6 L 13.4 7.6 C 13.4 11 11.1 13.7 8 14.6 C 4.9 13.7 2.6 11 2.6 7.6 L 2.6 3.6 Z";
    }
}

// 图标按钮的悬停提示内容。
export component TipBox inherits Rectangle {
    in property <string> text;
    background: Theme.surface-raised;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.dark ? #ffffff24 : #0000001f;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 5px;
        Text {
            text: root.text;
            font-size: 12px;
            color: Palette.foreground;
        }
    }
}
