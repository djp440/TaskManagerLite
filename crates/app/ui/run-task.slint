import { Button, CheckBox, LineEdit, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ShieldIcon } from "controls.slint";

// “运行新任务”对话框的数据与事件（Ctrl+N 或工具栏按钮打开）。
export global RunTaskData {
    in-out property <bool> open;
    // 输入框内容与“以管理员权限创建此任务”勾选；提交时 Rust 直接从这里读取。
    in-out property <string> input;
    in-out property <bool> as-admin;
    // 启动失败的原因；非空时显示在输入框下方，对话框保持打开。
    in-out property <string> error;
    // 正在启动（含等待 UAC）或正在选择文件。
    in property <bool> busy;
    // 最近使用的输入，最新在前。
    in property <[string]> history;
    callback submit();
    callback browse();
    callback opened();
}

export component RunTaskDialog inherits Rectangle {
    callback cancelled();

    background: #00000066;
    TouchArea { }

    function submit() {
        if !RunTaskData.busy && RunTaskData.input != "" {
            RunTaskData.error = "";
            RunTaskData.submit();
        }
    }

    // Esc 取消、回车确认：焦点在输入框、勾选框或按钮上时按键都会冒泡到这里。
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            if event.text == Key.Return {
                root.submit();
                return accept;
            }
            reject
        }

        card := Rectangle {
            width: min(480px, parent.width - 48px);
            height: body.preferred-height;
            x: (parent.width - self.width) / 2;
            y: max(24px, (parent.height - self.height) / 2);
            border-radius: 10px;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;

            body := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: @tr("运行新任务");
                    font-size: 18px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                Text {
                    text: @tr("输入程序、文件夹、文档或网址，系统会为你打开它。");
                    wrap: word-wrap;
                    color: Theme.subtle-text;
                }

                HorizontalLayout {
                    spacing: 8px;
                    command-input := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: @tr("例如 notepad、explorer、https://…");
                        text <=> RunTaskData.input;
                        edited(text) => {
                            RunTaskData.error = "";
                        }
                        accepted => {
                            root.submit();
                        }
                    }

                    Button {
                        text: @tr("浏览…");
                        enabled: !RunTaskData.busy;
                        clicked => {
                            RunTaskData.browse();
                        }
                    }
                }

                if RunTaskData.error != "": Text {
                    text: RunTaskData.error;
                    wrap: word-wrap;
                    color: Theme.danger;
                }

                if RunTaskData.history.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: @tr("最近使用");
                        font-size: 12px;
                        color: Theme.subtle-text;
                    }

                    ListView {
                        height: min(RunTaskData.history.length * 28px, 112px);
                        content-width: self.visible-width;
                        for entry[i] in RunTaskData.history: Rectangle {
                            height: 28px;
                            border-radius: 4px;
                            background: touch.has-hover ? Theme.hover : transparent;
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                text: entry;
                                overflow: elide;
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }

                            touch := TouchArea {
                                clicked => {
                                    RunTaskData.input = entry;
                                    RunTaskData.error = "";
                                    command-input.focus();
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    CheckBox {
                        text: @tr("以管理员权限创建此任务");
                        checked <=> RunTaskData.as-admin;
                    }

                    Rectangle {
                        width: 16px;
                        ShieldIcon {
                            y: (parent.height - self.height) / 2;
                            tint: Theme.subtle-text;
                        }
                    }
                }

                HorizontalLayout {
                    padding-top: 8px;
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("取消");
                        clicked => {
                            root.cancelled();
                        }
                    }

                    Button {
                        text: RunTaskData.busy ? @tr("正在启动…") : @tr("确定");
                        primary: true;
                        enabled: !RunTaskData.busy && RunTaskData.input != "";
                        clicked => {
                            root.submit();
                        }
                    }
                }
            }
        }
    }

    init => {
        command-input.focus();
    }
}
