import { Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { StatItem, StatsPanel } from "stats-panel.slint";

// 逻辑处理器网格里的一张小图。曲线路径由 Rust 按小图的实际尺寸生成。
export struct CoreGraph {
    label: string,
    value: string,
    line: string,
    area: string,
}

// 逻辑处理器网格的布局结果，由 Rust 的纯函数 `grid_plan` 算出（可单测）。
// scroll 为 true 时，小图不再被压到最小高度以下，网格改为在自己的区域内滚动。
export struct GridLayout {
    cols: int,
    rows: int,
    gap: length,
    cell-w: length,
    cell-h: length,
    content-h: length,
    scroll: bool,
}

// CPU 详情的数据与视图状态。放在全局对象里，不占用 AppWindow / PerformancePage 的属性。
export global CpuData {
    // 为 true 时显示每个逻辑处理器一张小图，否则显示整体曲线。
    in-out property <bool> per-core: false;
    in property <[CoreGraph]> cores;
    // 大号数值统计项（利用率、速度、进程、线程、句柄、正常运行时间）与基本信息键值，交给通用 StatsPanel 显示。
    in property <[StatItem]> stats;
    in property <[StatItem]> info;
    // 网格区（不是单张小图）的尺寸，由布局得出。Rust 用它和小图数量经同一个 grid-layout 算出小图尺寸并生成曲线，
    // 所以小图的列数、行数怎么变，曲线尺寸都跟小图实际尺寸一致。
    in-out property <length> grid-width;
    in-out property <length> grid-height;
    callback grid-resized();
    // 按小图数量与网格区尺寸计算列数、行数和小图尺寸，由 Rust 实现。
    pure callback grid-layout(int, length, length) -> GridLayout;
}

export component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    border-radius: 5px;
    background: root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        font-size: 12px;
        color: root.active ? Palette.foreground : Theme.subtle-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// “整体利用率 / 逻辑处理器”视图切换。
export component CpuModeSwitch inherits Rectangle {
    width: 176px;
    height: 24px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.divider;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        Segment {
            text: @tr("整体利用率");
            active: !CpuData.per-core;
            clicked => {
                CpuData.per-core = false;
            }
        }

        Segment {
            text: @tr("逻辑处理器");
            active: CpuData.per-core;
            clicked => {
                CpuData.per-core = true;
            }
        }
    }
}

component CoreCell inherits Rectangle {
    in property <CoreGraph> data;

    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.cpu.with-alpha(0.6);
    clip: true;

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        clip: true;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            commands: root.data.area;
            fill: Theme.cpu.with-alpha(0.16);
        }

        Path {
            width: 100%;
            height: 100%;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            commands: root.data.line;
            stroke: Theme.cpu;
            stroke-width: 1.2px;
        }
    }

    Text {
        x: 6px;
        y: 3px;
        text: root.data.label;
        font-size: 11px;
        color: Theme.subtle-text;
    }

    // 小格（窄于 96px 或矮于 28px）放不下数值，只保留核号。
    if root.width >= 96px && root.height >= 28px: Text {
        x: parent.width - self.width - 6px;
        y: 3px;
        text: root.data.value;
        font-size: 11px;
        color: Theme.subtle-text;
    }
}

// 每个逻辑处理器一张小图。列数、行数与小图尺寸由 Rust 的 `grid_plan` 计算：
// 让小图接近 1.6:1 的宽高比，不窄于 64px、不矮于 24px；核数多到放不下时在网格区内滚动，而不是把小图压扁。
export component CpuCoreGrid inherits Rectangle {
    property <GridLayout> plan: CpuData.grid-layout(CpuData.cores.length, root.width, root.height);

    // 只上报网格区的尺寸：它只随窗口布局变化，不受小图数量（模型从空到满）的影响。
    // changed 只在属性值“变化”时触发：网格创建时若布局已经给出最终尺寸，就不会有变化，
    // 所以创建时（init）也要主动上报一次。切到“逻辑处理器”视图时网格才被创建，这一次上报也让 Rust 立即刷新小图数据。
    init => {
        CpuData.grid-width = self.width;
        CpuData.grid-height = self.height;
        CpuData.grid-resized();
    }
    changed width => {
        CpuData.grid-width = self.width;
        CpuData.grid-resized();
    }
    changed height => {
        CpuData.grid-height = self.height;
        CpuData.grid-resized();
    }

    background: Theme.surface-raised;
    ScrollView {
        width: parent.width;
        height: parent.height;
        content-width: self.visible-width;
        content-height: root.plan.scroll ? root.plan.content-h : self.height;
        for core[i] in CpuData.cores: CoreCell {
            x: Math.mod(i, Math.max(root.plan.cols, 1)) * (root.plan.cell-w + root.plan.gap);
            y: Math.floor(i / Math.max(root.plan.cols, 1)) * (root.plan.cell-h + root.plan.gap);
            width: root.plan.cell-w;
            height: root.plan.cell-h;
            data: core;
        }
    }
}

// CPU 详情：通用统计面板（统计项 + 基本信息）。
// 与内存页一致，内容放在滚动区里：窗口很矮时先压缩上方的曲线，仍放不下就滚动，不会把状态栏挤出窗口。
export component CpuDetail inherits ScrollView {
    min-height: 80px;
    // 多余的高度全部给上方的曲线/网格，统计区只取自己需要的高度。
    vertical-stretch: 0;
    preferred-height: content.preferred-height;
    content-width: self.visible-width;
    content-height: content.preferred-height;

    content := VerticalLayout {
        width: root.visible-width;
        alignment: start;
        StatsPanel {
            stats: CpuData.stats;
            info: CpuData.info;
        }
    }
}
